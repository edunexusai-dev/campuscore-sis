{
  "name": "campuscore-sis",
  "private": true,
  "version": "1.0.0",
  "description": "CampusCore SIS — the academic system of record for modern higher education.",
  "workspaces": ["server", "client", "connector", "identity-sync"],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server"
  },
  "engines": { "node": ">=20" }
}
