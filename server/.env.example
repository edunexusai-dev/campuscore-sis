# ── CampusCore SIS server configuration ──
NODE_ENV=development
PORT=4000

# PostgreSQL connection (DBngin default: user "postgres", no password)
DATABASE_URL=postgresql://postgres@127.0.0.1:5434/campuscore?schema=public

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_SECRET=change-me
CLIENT_SECRET_PEPPER=change-me

# Public base URL of this API (used as JWT issuer/audience and in docs)
PUBLIC_API_URL=http://localhost:4000

# Comma-separated list of browser origins allowed to call /api/app (the portal frontend)
CORS_ORIGINS=http://localhost:5180

# Human session lifetime in hours
SESSION_TTL_HOURS=12

# Set true behind HTTPS (production) so cookies are marked Secure
COOKIE_SECURE=false

# Express "trust proxy" setting (e.g. 1 when behind one reverse proxy)
TRUST_PROXY=false

# Institution shown on the sign-in page (configuration, not code). Falls back to the oldest institution.
DEFAULT_INSTITUTION_SLUG=

# University sign-in (OpenID Connect), optional. All four of ISSUER, CLIENT_ID, CLIENT_SECRET and
# APP_URL enable it. Use a client of its own at the identity provider (never another app's client).
# OIDC_ISSUER=https://idp.example.edu/realms/university
# OIDC_CLIENT_ID=campuscore
# OIDC_CLIENT_SECRET=
# OIDC_APP_URL=https://sis.example.edu          # the web app origin; callback = <APP_URL>/api/app/auth/oidc/callback
# OIDC_ALLOW_HTTP=false                         # true only for a local development provider (refused in production)
# OIDC_DISPLAY_NAME=University ID
# OIDC_INSTITUTION_SLUG=feddrick                # institution whose student/faculty numbers the sign-in matches
# OIDC_STUDENT_NUMBER_CLAIM=student_number
# OIDC_EMPLOYEE_NUMBER_CLAIM=employee_number
# OIDC_JIT_ACCOUNTS=false                       # true: a person with records but no CampusCore login gets one (no password) at first sign-in
