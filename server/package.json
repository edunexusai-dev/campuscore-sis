{
  "name": "@campuscore/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "6.2.13",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "openid-client": "6.8.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
