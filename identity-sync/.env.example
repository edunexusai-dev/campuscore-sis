# CampusCore identity sync (command line). Server-side only: never expose these values to a browser, logs or git.
# Day to day, the CampusCore server provisions accounts automatically (IDENTITY_SYNC_* in server/.env, see
# docs/IDENTITY_PROVISIONING.md). This CLI remains for dry runs, full reconciliations and audits.

# CampusCore integration API: an integration client (Admin > Developer & integrations) with ONLY the people:read scope.
CAMPUSCORE_BASE_URL=http://localhost:4000
CAMPUSCORE_CLIENT_ID=<integration client id, people:read only>
CAMPUSCORE_CLIENT_SECRET=<shown once when the integration client is created>

# Keycloak: a dedicated confidential client with ONLY "Service accounts" enabled and the realm-management roles
# manage-users, view-users and query-users. Never admin-cli, never an administrator's password.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=edunexusai-feddrick
KEYCLOAK_CLIENT_ID=campuscore-identity-sync
KEYCLOAK_CLIENT_SECRET=<campuscore-identity-sync client secret from Keycloak>

# Optional
# SYNC_STATE_FILE=.sync-state.json         where the last successful run is remembered (incremental runs)
# SYNC_SEND_SETUP_EMAIL=false              true: new accounts get Keycloak's "set your password" email (needs realm SMTP)
# SYNC_TIMEOUT_MS=10000
