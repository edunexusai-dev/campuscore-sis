# ---------------------------------------------------------------------------
# CampusCore SIS — production environment template
# All values are placeholders. Replace <…> tokens before deployment.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# PostgreSQL on RDS (dedicated campuscore database)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@edunexus-postgres.cc7y0cms2un6.us-east-1.rds.amazonaws.com:5432/campuscore?schema=public&sslmode=require"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_SECRET=<generate-random-64-chars>
CLIENT_SECRET_PEPPER=<generate-random-16-chars>

# Public URL of this API (used as JWT issuer/audience and in API docs)
PUBLIC_API_URL=https://<CAMPUSCORE_DOMAIN>

# Comma-separated browser origins allowed to call /api/app
CORS_ORIGINS=https://<CAMPUSCORE_DOMAIN>

SESSION_TTL_HOURS=12

# Must be true in production (the app refuses to start otherwise)
COOKIE_SECURE=true

# Behind nginx reverse proxy: trust one level of X-Forwarded-* headers
TRUST_PROXY=1

# Default institution slug for the sign-in page
DEFAULT_INSTITUTION_SLUG=feddrick

# ---------------------------------------------------------------------------
# University sign-in (OpenID Connect via Keycloak)
# ---------------------------------------------------------------------------
OIDC_ISSUER=https://<KEYCLOAK_DOMAIN>/realms/edunexusai-feddrick
OIDC_CLIENT_ID=campuscore
OIDC_CLIENT_SECRET=<from-keycloak-campuscore-client-credentials>
OIDC_APP_URL=https://<CAMPUSCORE_DOMAIN>
# OIDC_ALLOW_HTTP is always false in production (enforced by config.js)
OIDC_DISPLAY_NAME=Feddrick University
OIDC_INSTITUTION_SLUG=feddrick
OIDC_STUDENT_NUMBER_CLAIM=student_number
OIDC_EMPLOYEE_NUMBER_CLAIM=employee_number
OIDC_JIT_ACCOUNTS=true

# ---------------------------------------------------------------------------
# Automatic university-account provisioning (docs/IDENTITY_PROVISIONING.md)
# Dedicated service-account client; NEVER the sign-in client's id or secret (the app refuses to start).
# ---------------------------------------------------------------------------
IDENTITY_SYNC_ENABLED=false
IDENTITY_SYNC_KEYCLOAK_URL=https://<KEYCLOAK_DOMAIN>
IDENTITY_SYNC_KEYCLOAK_REALM=edunexusai-feddrick
IDENTITY_SYNC_CLIENT_ID=campuscore-identity-sync
IDENTITY_SYNC_CLIENT_SECRET=<from-keycloak-campuscore-identity-sync-client-credentials>
# true only once the realm has SMTP configured
IDENTITY_SYNC_SEND_SETUP_EMAIL=false
