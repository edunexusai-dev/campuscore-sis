{
  "info": {
    "name": "CampusCore SIS \u2013 Feddrick integration verification",
    "description": "Step-by-step verification of the CampusCore SIS integration API for Feddrick University / EdunexusAI. Run the folders in order. Uses the environment variables baseUrl, clientId, clientSecret (keep the secret in the environment's *current value* only, never in a shared/exported value). Write steps require the corresponding scopes on the client and the policies enabled under Admin \u2192 Policies; otherwise they demonstrate the rejection codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authenticate",
      "item": [
        {
          "name": "Get access token (client credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "oauth",
                "token"
              ]
            },
            "description": "Stores the token in {{accessToken}}. Tokens last the client's configured lifetime (e.g. 60 minutes); in EdunexusAI the connector refreshes automatically.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientSecret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + bearer token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token_type).to.eql('Bearer'); });",
                  "pm.environment.set('accessToken', pm.response.json().access_token);",
                  "pm.test('expires_in present', () => pm.expect(pm.response.json().expires_in).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (institution + scopes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feddrick institution', () => pm.expect(pm.response.json().institution.slug).to.eql('feddrick'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Effective write capabilities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/capabilities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "capabilities"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "console.log(pm.response.json().data.operations.map(o => `${o.operation}: ${o.effective ? 'ALLOWED' : 'blocked \u2013 ' + o.reason}`).join('\\n'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Institution & reads",
      "item": [
        {
          "name": "Institution",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/institution",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "institution"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feddrick University', () => { const d = pm.response.json().data; pm.expect(d.name).to.eql('Feddrick University'); pm.expect(d.studentEmailDomain).to.eql('students.feddrick.edu'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Programs (pick a programId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/programs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "programs"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json().data.find(x => x.code === 'BS-CS') || pm.response.json().data[0]; pm.environment.set('programId', p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students?search=chen&pageSize=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "chen"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('paginated', () => pm.expect(pm.response.json().pagination).to.be.an('object'));",
                  "pm.environment.set('studentId', pm.response.json().data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get student (note ETag)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{studentId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('has ETag', () => pm.expect(pm.response.headers.get('ETag')).to.match(/^W\\//));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{studentId}}/schedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{studentId}}",
                "schedule"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Student academic record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{studentId}}/academic-record",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{studentId}}",
                "academic-record"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Student write-back",
      "item": [
        {
          "name": "Create student (Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "X-Acting-User",
                "value": "postman:verifier"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Verification\",\n  \"email\": \"postman.{{runId}}@students.feddrick.edu\",\n  \"programId\": \"{{programId}}\",\n  \"status\": \"ADMITTED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('runId', Date.now()); pm.environment.set('idemKey', 'postman-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created (or 422 policy_disabled / 403 insufficient_scope if not enabled)', () => pm.expect([201, 403, 422]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) pm.environment.set('newStudentId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry create with the SAME key (no duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Verification\",\n  \"email\": \"postman.{{runId}}@students.feddrick.edu\",\n  \"programId\": \"{{programId}}\",\n  \"status\": \"ADMITTED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('newStudentId')) {",
                  "  pm.test('replayed, same id', () => { pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'); pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('newStudentId')); });",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('newStudentId')) { console.log('Skipped: no student was created in this run (create needs students:create + policy).'); pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update permitted field",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Acting-User",
                "value": "postman:verifier"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{newStudentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{newStudentId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+1 (555) 010-0001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or a clear field_not_permitted', () => pm.expect([200, 403]).to.include(pm.response.code));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('newStudentId')) { console.log('Skipped: no student was created in this run (create needs students:create + policy).'); pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update protected field (must fail 400)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{studentId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentNumber\": \"S0000000\",\n  \"academicStanding\": \"DEANS_LIST\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('protected fields are never written', () => {",
                  "  const code = pm.response.json().error.code;",
                  "  if (pm.response.code === 403) pm.expect(code).to.eql('insufficient_scope'); // client has no student write scope at all",
                  "  else { pm.response.to.have.status(400); pm.expect(code).to.eql('validation_error'); }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate (history retained)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Acting-User",
                "value": "postman:verifier"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{newStudentId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{newStudentId}}",
                "deactivate"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman verification complete\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 WITHDRAWN (or policy/scope rejection)', () => pm.expect([200, 403, 422]).to.include(pm.response.code));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('newStudentId')) { console.log('Skipped: no student was created in this run (create needs students:create + policy).'); pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Student audit history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{newStudentId}}/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{newStudentId}}",
                "audit"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('newStudentId')) { console.log('Skipped: no student was created in this run (create needs students:create + policy).'); pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Identity mapping",
      "item": [
        {
          "name": "Reconcile an EdunexusAI account",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/reconcile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "reconcile"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalSystem\": \"edunexusai\",\n  \"candidates\": [\n    {\n      \"externalUserId\": \"postman-user-1\",\n      \"recordType\": \"STUDENT\",\n      \"email\": \"maya.chen@students.feddrick.edu\"\n    },\n    {\n      \"externalUserId\": \"postman-user-2\",\n      \"recordType\": \"STUDENT\",\n      \"firstName\": \"Maya\",\n      \"lastName\": \"Chen\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 403) {",
                  "  pm.test('client lacks identity:read \u2192 403 insufficient_scope', () => pm.expect(pm.response.json().error.code).to.eql('insufficient_scope'));",
                  "} else {",
                  "  pm.test('email \u2192 CANDIDATE/LINKED, name only \u2192 UNMATCHED', () => { const d = pm.response.json().data; pm.expect(['CANDIDATE', 'LINKED', 'AMBIGUOUS']).to.include(d[0].status); pm.expect(d[1].status).to.eql('UNMATCHED'); });",
                  "  const c = pm.response.json().data[0]; if (c.candidates && c.candidates[0]) pm.environment.set('candidateSisId', c.candidates[0].sisId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Link account (explicit confirmation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Acting-User",
                "value": "postman:verifier"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "links"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalSystem\": \"edunexusai\",\n  \"externalUserId\": \"postman-user-1\",\n  \"externalEmail\": \"maya.chen@students.feddrick.edu\",\n  \"recordType\": \"STUDENT\",\n  \"sisRecordId\": \"{{candidateSisId}}\",\n  \"confirm\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 linked (or 409 if already linked / 422 policy_disabled)', () => pm.expect([201, 409, 422, 403]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) pm.environment.set('linkId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve account \u2192 SIS record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/resolve?externalSystem=edunexusai&externalUserId=postman-user-1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "resolve"
              ],
              "query": [
                {
                  "key": "externalSystem",
                  "value": "edunexusai"
                },
                {
                  "key": "externalUserId",
                  "value": "postman-user-1"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Revoke link (history kept)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/links/{{linkId}}/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "links",
                "{{linkId}}",
                "revoke"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
