            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman verification finished\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('linkId')) { console.log('Skipped: no link was created in this run.'); pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Token lifecycle",
      "item": [
        {
          "name": "Revoke current token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/oauth/revoke",
              "host": [
